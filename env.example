# APP_URL: URL pública onde a aplicação está hospedada (ex: https://4ktreinamentos.com.br ou URL do Cloud Run / Vercel)
APP_URL="http://localhost:3000"

# VERCEL BLOB: Token de leitura e escrita para armazenamento de imagens, vídeos, PDFs e certificados emitidos
BLOB_READ_WRITE_TOKEN=""

# INFINITEPAY: InfiniteTag (handle) padrão da sua conta InfinitePay (também configurável no Painel Admin)
INFINITEPAY_HANDLE=""

# ADMIN SESSION SECRET: Segredo HMAC para sessão administrativa local/API
ADMIN_SESSION_SECRET="4k-treinamentos-dev-secret-change-in-prod"

# FIREBASE ADMIN SDK (Opcional para webhook server-side em produção na Vercel)
# Cole aqui o JSON da Service Account em uma única linha para permitir que o webhook libere matrículas automaticamente no servidor
FIREBASE_SERVICE_ACCOUNT_JSON=""
